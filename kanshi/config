output "*MND508ZB1-1*" {
	mode 2880x1920@120.000
	scale 2
	alias $FW13
}

output "DP-1" {
	mode 3840x2160@60.00Hz
	adaptive_sync off
	scale 1.75
	alias $NUC
}

output "LG Electronics LG ULTRAGEAR+ 0x01010101" {
  mode 3840x2160@144.00Hz
	adaptive_sync off
  scale 1.75
  alias $HOME_LG
}

output "HP Inc. HP Z27n G2 6CM80425VV" {
  mode 2560x1440@74.97
  scale 1.33333
  alias $HOME_HP
}

output "Samsung Electric Company LS34A650U H4ZT109948" {
	mode 3440x1440@99.98
	scale 1.5
	alias $WORK_CURVED
}

output "Samsung Electric Company LS32A600U H4ZT300201" {
	mode 2560x1440@74.998
	scale 1.20
	alias $WORK_FLAT
}

output "*AU Optronics*" {
  mode 1920x1200@60.03
  scale 1.2
  alias $HP
}

output "SONY TV  *30" {
	mode 3840x2160@60.000
	scale 2
	alias $SONY
}

# (Keep your other output definitions exactly as they are)

# --- Built-in Profiles ---
profile builtin-fw13 {
  output $FW13 enable
}

profile builtin-hp {
  output $HP enable
}

# --- Home LG Setup ---
profile docked-home-fw13 {
  output $FW13 disable
  output $HOME_LG enable
}

profile docked-home-hp {
  output $HP disable
  output $HOME_LG enable
}

# --- Home HP Monitor Setup ---
profile docked-hp-fw13 {
  output $FW13 enable position 212,1081
  output $HOME_HP enable position 0,0
}

profile docked-hp-hp {
  output $HP enable position 212,1081
  output $HOME_HP enable position 0,0
}

# --- Work Setup ---
profile docked-work-fw13 {
  output $FW13 disable
  output $WORK_FLAT enable
}

profile docked-work-hp {
  output $HP disable
  output $WORK_FLAT enable
}

# --- Sony TV Setup ---
profile mobb1-fw13 {
  output "Sony SONY TV  *30 0x01010101" {
    mode 1920x1080@60Hz
  }
  output $FW13 enable
}

profile mobb1-hp {
  output "Sony SONY TV  *30 0x01010101" {
    mode 3840x2160@60Hz
		scale 2
  }
  output $FW13 disable
}
