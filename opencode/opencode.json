{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"freecad": {
			"type": "local",
			"command": [
				"sh",
				"-c",
				"exec nix run \"$HOME/workspace/personal/freecad-mcp#default\""
			],
			"enabled": true
		},
		"akind-design": {
			"type": "local",
			"command": [
				"sh",
				"-c",
				"exec node \"$HOME/workspace/testing/akind-design-mcp/src/server.ts\""
			],
			"enabled": true
		}
	}
}
