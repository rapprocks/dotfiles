{
	"$schema": "https://opencode.ai/config.json",
	"model": "github-copilot/claude-3-5-sonnet",
	"provider": {
		"ollama": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama (Local)",
			"options": {
				"baseURL": "http://127.0.0.1:11434/v1"
			},
			"models": {
				"qwen3-coder:30b": {
					"name": "Local Qwen3 Coder 30B",
					"options": {
						"num_ctx": 32768
					}
				},
				"deepseek-r1:14b": {
					"name": "Local DeepSeek R1 14B",
					"options": {
						"num_ctx": 32768
					}
				}
			}
		}
	},
