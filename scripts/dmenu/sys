#!/usr/bin/env bash

case "$(printf "kill\nzzz\nreboot\nshutdown" | rofi -dmenu -i -l 4 -p "sys ")" in
    kill)
        ps -u "$USER" -o pid,comm,%cpu,%mem |
            rofi -dmenu -i -l 10 -p "Kill:" |
            awk 'NR > 1 {print $1}' |
            xargs -r kill
        ;;
    zzz)
        hyprlock && systemctl suspend
        ;;
    reboot)
        systemctl reboot
        ;;
    shutdown)
        systemctl poweroff
        ;;
    *)
        exit 0
        ;;
esac
