{
	"custom/wg-work": {
		"format": "<span size='10pt'>{text}</span>",
		"return-type": "json",
		"exec": "bash $HOME/.dotfiles/scripts/wg-work-status.sh",
		"interval": 10,
		"signal": 8,
		"tooltip": true,
		"on-click": "alacritty --class=com.earn.tuiFloat --title='WireGuard Work' -e bash -lc '$HOME/.dotfiles/scripts/wg-work-toggle.sh'"
	}
}
