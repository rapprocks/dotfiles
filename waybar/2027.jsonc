[
	{
		"position": "top",
		"layer": "top",
		"height": 20,
		"reload_style_on_change": true,
		"modules-left": [
			"custom/cli",
			"niri/workspaces"
		],
		"modules-center": [
			"group/center"
		],
		"modules-right": [
			"custom/notification",
			"bluetooth",
			"network",
			"pulseaudio",
			"battery"
		],
		"clock": {
			"format": "{:%H:%M}",
			"format-alt": "  {:%A, %B %d, %Y}",
			"tooltip-format": "<tt><small>{calendar}</small></tt>",
			"calendar": {
				"mode": "month",
				"mode-mon-col": 3,
				"format": {
					"months": "<span color='#E2E4F0'><b>{}</b></span>",
					"days": "<span color='#A3A7C1'>{}</span>",
					"weeks": "<span color='#A3A7C1'><b>W{}</b></span>",
					"weekdays": "<span color='#8E94B2'><b>{}</b></span>",
					"today": "<span color='#FFC0CB'><b><u>{}</u></b></span>"
				}
			}
		},
		"custom/cli": {
			"format": "<span size='10pt'></span>"
		},
		"group/center": {
			"orientation": "horizontal",
			"drawer": {
				"transition-duration": 200,
				"children-class": "cssstylinighere",
				"transition-left-to-right": false
			},
			"modules": [
				"clock",
				"idle_inhibitor"
			]
		},
		"niri/workspaces": {
			//"active-only": false,
			"all-outputs": false,
			"disable-scroll": false,
			"hide-empty": true,
			"format": "{icon}",
			"on-click": "activate",
			"format-icons": {
				"urgent": "",
				"active": "",
				"default": ""
			},
			"sort-by-number": true
		},
		"pulseaudio": {
			"format": "{icon}",
			"format-icons": {
				"default": [
					"",
					"",
					"",
					""
				],
				"headphone": "",
				"headset": ""
			},
			"format-muted": "",
			"on-click": "pavucontrol"
		},
		"battery": {
			"interval": 30,
			"format": "<span size='10pt'>{icon}</span>",
			"format-charging": "<span size='10pt'>󰂄</span>",
			"format-plugged": "<span size='10pt'>󰂄</span>",
			"tooltip-format": "Battery: <big><b>{capacity}%</b></big>\nPower draw: <b>{power}W</b>\nTime remaining: <b>{timeTo}</b>\nHealth: <b>{health}%</b>\nCycles: <b>{cycles}</b>",
			"format-icons": {
				"default": [
					"󰁺",
					"󰁻",
					"󰁼",
					"󰁽",
					"󰁾",
					"󰁿",
					"󰂀",
					"󰂁",
					"󰂂"
				]
			},
			"events": {
				"on-discharging-warning": "/run/current-system/sw/bin/notify-send -u normal 'Low Battery'",
				"on-discharging-critical": "/run/current-system/sw/bin/notify-send -u critical 'Very Low Battery'",
				"on-discharging": "/run/current-system/sw/bin/notify-send -u normal 'Power Switch' Discharging",
				"on-charging": "/run/current-system/sw/bin/notify-send -u normal 'Power Switch' Charging"
			},
			"states": {
				"critical": 15,
				"good": 95,
				"warning": 30
			}
		},
		"network": {
			"tooltip": true,
			"format-wifi": "<span size='10pt'>{icon}</span>",
			"format-icons": [
				"󰤟",
				"󰤢",
				"󰤥"
			],
			"rotate": 0,
			"format-ethernet": "󰈀 ",
			"tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>",
			"format-linked": "󰈀 {ifname} (No IP)",
			"format-disconnected": " ",
			"tooltip-format-disconnected": "Disconnected"
		},
		"bluetooth": {
			//"controller": "controller1",
			"format": "<span size='10pt'></span>",
			"format-disabled": "<span size='10pt'>󰂲</span>",
			"tooltip-format": "{controller_alias} - {controller_address}",
			"tooltip-format-connected": "{controller_alias} - {controller_address}\n{device_enumerate}",
			"tooltip-format-enumerate-connected": "{device_alias} - {device_address}",
			"on-click": "/run/current-system/sw/bin/alacritty --class=com.earn.bluetui --title='BlueTUI' -e /run/current-system/sw/bin/bluetui"
		},
		"idle_inhibitor": {
			"format": "<span size='10pt'>{icon}</span>",
			"format-icons": {
				"activated": "󰅶",
				"deactivated": "󰾪"
			}
		},
		"custom/notification": {
			"tooltip": false,
			"format": "<span size='10pt'>{icon}</span>",
			"format-icons": {
				"notification": "󱅫",
				"none": "󰂚",
				"dnd-notification": "󰂠",
				"dnd-none": "󰪓",
				"inhibited-notification": "󰂛",
				"inhibited-none": "󰪑",
				"dnd-inhibited-notification": "󰂛",
				"dnd-inhibited-none": "󰪑"
			},
			"return-type": "json",
			"exec-if": "which swaync-client",
			"exec": "/run/current-system/sw/bin/swaync-client -swb",
			"on-click": "/run/current-system/sw/bin/swaync-client -t -sw",
			"on-click-right": "/run/current-system/sw/bin/swaync-client -d -sw",
			"escape": true
		}
	}
]
